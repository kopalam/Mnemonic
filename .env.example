# Mnemonic 环境变量配置

# PostgreSQL 数据库密码（与 docker-compose.yml 中 POSTGRES_PASSWORD 一致）
MNEMONIC_DB_PASSWORD=your_db_password_here

# LLM API Key（Gemma-4 或其他兼容 OpenAI API 的服务）
MNEMONIC_LLM_API_KEY=your_llm_api_key_here

# LLM Fallback API Key（可选，降级备用）
MNEMONIC_LLM_FALLBACK_API_KEY=your_fallback_api_key_here

# Embedding 配置（支持 SiliconFlow 或本地模型）
# 默认使用 SiliconFlow Qwen3-Embedding-0.6B
# 如需本地模型，设置 MNEMONIC_EMBEDDING_BASE_URL 指向本地服务

# Embedding API Key（SiliconFlow 或其他 embedding 服务）
MNEMONIC_EMBEDDING_API_KEY=your_embedding_api_key_here

# Embedding Base URL（可选，默认 SiliconFlow）
# MNEMONIC_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# Embedding Model（可选，默认 Qwen/Qwen3-Embedding-0.6B）
# MNEMONIC_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Embedding Dimension（可选，默认 1024）
# MNEMONIC_EMBEDDING_DIM=1024
