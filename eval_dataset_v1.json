{
  "version": "1.0",
  "description": "Mnemonic AI Agent Memory System - 4-Dimension Evaluation",
  "dimensions": {
    "d1_extraction": {
      "description": "非结构化对话 → 检查提取的记忆事实",
      "method": "输入对话片段，通过 /memories/extract 端点提取，人工比对提取结果与对话中的实际事实",
      "metric": "F1-Score = 2*P*R/(P+R), P=正确提取/总提取, R=正确提取/应有事实",
      "pass_criteria": "F1 >= 0.75",
      "test_cases": [
        {
          "id": "ext-01",
          "input_conversation": "我今天用Solana的Raydium做了一个SOL-USDC的swap，滑点设的1%，gas费大概0.00025 SOL。",
          "expected_facts": [
            "用户使用Raydium做swap",
            "交易对是SOL-USDC",
            "滑点设置1%",
            "gas费约0.00025 SOL"
          ],
          "anti_facts": [
            "用户喜欢炒币",
            "Raydium是DEX"
          ]
        },
        {
          "id": "ext-02",
          "input_conversation": "那个TG bot昨天崩了一次，大概是晚上11点，用户群里有人说frozen了。我重启了服务就好了，可能是内存泄漏。",
          "expected_facts": [
            "TG bot昨晚11点左右崩溃过一次",
            "用户反馈frozen",
            "重启服务后恢复",
            "可能原因: 内存泄漏"
          ],
          "anti_facts": [
            "TG bot经常崩溃"
          ]
        },
        {
          "id": "ext-03",
          "input_conversation": "我不喜欢太长的报告，给我bullet points就行。数字要精确到小数点后两位。",
          "expected_facts": [
            "偏好简洁的bullet points格式",
            "数字精度要求精确到小数点后两位"
          ],
          "anti_facts": [
            "不喜欢看报告"
          ]
        },
        {
          "id": "ext-04",
          "input_conversation": "zSunKoin的Data Agent用CCXT拉K线数据，15分钟周期，存到TimescaleDB。BTC价格用WebSocket订阅Binance的实时流。",
          "expected_facts": [
            "zSunKoin Data Agent使用CCXT获取K线数据",
            "K线周期15分钟",
            "数据存储到TimescaleDB",
            "BTC价格通过WebSocket订阅Binance实时流"
          ],
          "anti_facts": [
            "zSunKoin用Binance API"
          ]
        },
        {
          "id": "ext-05",
          "input_conversation": "飞书的文档API太难用了，权限搞了三天才通过。wiki:wiki:readonly和wiki:node:read这两个scope必须都要开。",
          "expected_facts": [
            "飞书文档API权限配置耗时约三天",
            "需要的权限scope: wiki:wiki:readonly和wiki:node:read"
          ],
          "anti_facts": [
            "飞书API不好用"
          ]
        }
      ]
    },
    "d2_recency": {
      "description": "矛盾信息输入 → 验证新旧信息覆盖，无逻辑冲突",
      "method": "先写入A信息，再写入矛盾的B信息，搜索时应返回B而非A",
      "metric": "冲突解决率 = 正确返回新信息的查询数 / 总冲突查询数",
      "pass_criteria": "冲突解决率 >= 90%",
      "test_cases": [
        {
          "id": "rec-01",
          "old_info": "Mnemonic系统的API端口是8000",
          "new_info": "Mnemonic系统的API端口已改为8010",
          "query": "Mnemonic的API端口是多少",
          "expected_answer": "8010",
          "expected_not": "8000"
        },
        {
          "id": "rec-02",
          "old_info": "Boss的TG用户名是@old_boss_name",
          "new_info": "Boss的TG用户名已改为@web3_boss_sol",
          "query": "Boss的Telegram用户名",
          "expected_answer": "@web3_boss_sol",
          "expected_not": "@old_boss_name"
        },
        {
          "id": "rec-03",
          "old_info": "项目使用GPT-4作为默认LLM模型",
          "new_info": "项目已切换到自部署的Gemma-4作为LLM模型",
          "query": "项目用的是什么LLM",
          "expected_answer": "Gemma-4",
          "expected_not": "GPT-4"
        },
        {
          "id": "rec-04",
          "old_info": "Solana的RPC节点使用公共endpoint",
          "new_info": "Solana RPC已迁移到Helius付费节点",
          "query": "Solana RPC节点用的哪个",
          "expected_answer": "Helius",
          "expected_not": "公共endpoint"
        },
        {
          "id": "rec-05",
          "old_info": "数据库密码是old_password_123",
          "new_info": "数据库密码已更新为new_secure_pass_456",
          "query": "Mnemonic的数据库密码",
          "expected_answer": "new_secure_pass_456",
          "expected_not": "old_password_123"
        }
      ]
    },
    "d3_robustness": {
      "description": "50%废话对话 → 验证记忆库只保留有效Fact",
      "method": "输入含50%废话的对话片段，验证extract后不产生废话记忆",
      "metric": "噪声率 = 噪声记忆数 / 总提取记忆数",
      "pass_criteria": "噪声率 <= 10%",
      "test_cases": [
        {
          "id": "rob-01",
          "input_conversation": "嗯嗯好的。那个coinAnalysis项目现在代码有851行了。哈哈今天天气真不错啊。我觉得可以开始做压力测试了。你说对吧？嗯对，周末去看电影了。zSunKoin的Data Agent用CCXT拉数据。中午吃什么好呢。",
          "expected_to_extract": [
            "coinAnalysis项目代码851行",
            "计划开始做压力测试",
            "zSunKoin Data Agent使用CCXT拉数据"
          ],
          "noise_should_not_extract": [
            "今天天气不错",
            "周末去看电影",
            "中午吃什么",
            "嗯嗯好的"
          ]
        },
        {
          "id": "rob-02",
          "input_conversation": "哈哈哈笑死我了这个meme。Boss要求TG Bot的消息格式用Markdown。你说这个项目什么时候能上线啊？我也不确定。Mnemonic用FastAPI写的API。明天要开会讨论roadmap。对了你吃了吗。",
          "expected_to_extract": [
            "Boss要求TG Bot消息格式用Markdown",
            "Mnemonic用FastAPI写API"
          ],
          "noise_should_not_extract": [
            "哈哈哈笑死",
            "什么时候上线",
            "你吃了吗"
          ]
        },
        {
          "id": "rob-03",
          "input_conversation": "啊对对对你说的都对。Hermes Agent的记忆系统需要支持四级命名空间。好嘞收到。飞书文档的API权限终于通过了。这周好累啊。pgvector支持的最大维度是2000对于IVFFlat索引。我去喝杯咖啡。",
          "expected_to_extract": [
            "Hermes Agent记忆系统需要支持四级命名空间",
            "飞书文档API权限已通过",
            "pgvector IVFFlat索引最大支持2000维度"
          ],
          "noise_should_not_extract": [
            "好累",
            "喝咖啡",
            "啊对对对"
          ]
        }
      ]
    },
    "d4_relevance": {
      "description": "基于当前Context检索 → 验证召回信息与当前任务高度相关",
      "method": "给定当前上下文/任务描述，搜索记忆，验证TOP-K召回的相关性",
      "metric": "L1=TOP-1命中率, L2=TOP-3命中率, L3=MRR(平均倒数排名)",
      "pass_criteria": "L1 >= 75%, L2 >= 90%, L3 >= 0.85",
